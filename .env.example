# ─── MiMo API Configuration ─────────────────────────────────────────────────
# Get your API key at: https://xiaomimimo.com
MIMO_API_KEY=your_api_key_here
MIMO_API_BASE=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_MAX_TOKENS=8192

# ─── Probe Settings ─────────────────────────────────────────────────────────
PROBE_TIMEOUT=120
PROBE_ENCODING=utf-8

# ─── Output Settings ────────────────────────────────────────────────────────
OUTPUT_FORMAT=json+markdown
SAVE_RAW_PROBE=true

# ─── RAG Settings ───────────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_MAX_CONTEXT=5000
