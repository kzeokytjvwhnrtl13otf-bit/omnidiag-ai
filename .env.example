# ─── LLM API Configuration (OpenAI-compatible endpoint) ─────────────────────
# Works with: OpenAI, DeepSeek, Qwen, MiMo, Ollama, or any OpenAI-compatible API
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=8192

# ─── Probe Settings ─────────────────────────────────────────────────────────
PROBE_TIMEOUT=120
PROBE_ENCODING=utf-8

# ─── Output Settings ────────────────────────────────────────────────────────
OUTPUT_FORMAT=json+markdown
SAVE_RAW_PROBE=true

# ─── RAG Settings ───────────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_MAX_CONTEXT=5000
